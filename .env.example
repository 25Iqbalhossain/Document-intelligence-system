# Copy to .env and fill in. Never commit .env.
DOCINT_ENVIRONMENT=development
DOCINT_DATABASE_URL=postgresql+psycopg://docint:change-me@postgres:5432/docint
DOCINT_REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCINT_SECRET_KEY=
DOCINT_STORAGE_ROOT=/data/storage
DOCINT_MAX_UPLOAD_BYTES=104857600
DOCINT_PDF_BATCH_PAGES=20

# LLM: "mock" runs without keys (tests/demos only, not for evaluation)
DOCINT_LLM_PROVIDER=mock
DOCINT_LLM_BASE_URL=
DOCINT_LLM_API_KEY=
DOCINT_LLM_MODEL=
# Optional second model on the same endpoint, tried only if the primary's output stays invalid after a repair retry
DOCINT_LLM_FALLBACK_MODEL=
DOCINT_LLM_JSON_MODE=true
DOCINT_PROMPT_VERSION=invoice-v1
# Fields below this confidence send the invoice to human review
DOCINT_EXTRACTION_MIN_CONFIDENCE=0.7
# Documents not recognised as invoices: true = route to review, false = mark processed
DOCINT_EXTRACTION_REVIEW_NON_INVOICES=true
DOCINT_EMBEDDING_PROVIDER=mock
DOCINT_EMBEDDING_MODEL=all-MiniLM-L6-v2
DOCINT_EMBEDDING_DIM=384

# Used by docker-compose for the postgres service
POSTGRES_USER=docint
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docint
